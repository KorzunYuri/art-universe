# Dev environment overrides for Music Quiz module
# Module runs in IntelliJ and connects to Docker database via localhost:EXTERNAL_PORT

# Database
MU_DATA_DB_HOST=localhost
MU_DATA_DB_PORT=7789

# Application
MU_QUIZ_APP_INTERNAL_PORT=7083
MU_QUIZ_APP_EXTERNAL_PORT=7083
MU_QUIZ_APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

SPRING_PROFILES_ACTIVE=dev
