# Docker Compose environment variables for dev environment
# Used by env/docker/dev/docker-compose.yml

# Database external port mappings
MURAW_LASTFM_DB_MASTER_EXTERNAL_PORT=7799
MURAW_LASTFM_DB_REPLICA_EXTERNAL_PORT=7798
MU_DATA_DB_PORT=7789

# Replication password (referenced in docker-compose.yml)
MURAW_LASTFM_DB_REPLICATION_PASSWORD=12345

# Monitoring and tracing external port mappings
PROMETHEUS_PORT=7090
GRAFANA_PORT=7000
ZIPKIN_EXTERNAL_PORT=7411

# Grafana configuration
PROMETHEUS_DATASOURCE_UID=prometheus_dev
