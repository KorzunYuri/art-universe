# Dev environment overrides for LastFM modules
# Modules run in IntelliJ and connect to Docker databases via localhost:EXTERNAL_PORT

# Database - Master (write operations)
MURAW_LASTFM_DB_MASTER_HOST=localhost
MURAW_LASTFM_DB_MASTER_PORT=7799

# Database - Replica (read operations)
MURAW_LASTFM_DB_REPLICA_HOST=localhost
MURAW_LASTFM_DB_REPLICA_PORT=7798

# LastFM REST API (read operations) ports for dev environment
MURAW_LASTFM_REST_API_INTERNAL_PORT=7084
MURAW_LASTFM_REST_API_EXTERNAL_PORT=7084
MURAW_LASTFM_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:5173

# LastFM ETL REST API (write operations) ports for dev environment
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=7085
MURAW_LASTFM_ETL_REST_API_EXTERNAL_PORT=7085
MURAW_LASTFM_ETL_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ETL modules actuator ports for dev environment
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=7086
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=7086
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=7087
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=7087
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=7088
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=7088

SPRING_PROFILES_ACTIVE=dev

# Dependencies - connect to other modules running in IntelliJ
MU_DATA_APP_HOST=localhost
MU_DATA_APP_PORT=7082
