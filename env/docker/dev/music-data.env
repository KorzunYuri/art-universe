# Dev environment overrides for Music Data module
# Module runs in IntelliJ and connects to Docker database via localhost:EXTERNAL_PORT

# Application
MU_DATA_APP_INTERNAL_PORT=7082
MU_DATA_APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:7085

# Music Master Semantic Analysis Trigger
MUSIC_MASTER_SEMANTIC_ANALYSIS_TRIGGER_PORT=7101
