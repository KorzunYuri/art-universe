# Docker Compose environment variables for local deployment
# Used by env/docker/deploy.bat when running: deploy.bat local

# Database external port mappings
MURAW_LASTFM_DB_MASTER_EXTERNAL_PORT=9999
MURAW_LASTFM_DB_REPLICA_EXTERNAL_PORT=9998
MU_DATA_DB_EXTERNAL_PORT=9989

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_HOST=localhost
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_EXTERNAL_PORT=9084

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_HOST=localhost
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_EXTERNAL_PORT=9085

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=9096
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=9097
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=9098

# Music Data service
MU_DATA_APP_HOST=localhost
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_APP_EXTERNAL_PORT=9082

# Art Data service
ART_DATA_APP_HOST=localhost
ART_DATA_APP_INTERNAL_PORT=8080
ART_DATA_APP_EXTERNAL_PORT=9081

# Music Quiz service
MU_QUIZ_APP_HOST=localhost
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_APP_EXTERNAL_PORT=9083

# UI
MU_UI_EXTERNAL_PORT=4000

# Monitoring tools
PROMETHEUS_PORT=9090
GRAFANA_PORT=9000
PROMETHEUS_DATASOURCE_UID=prometheus_local

# Replication password (referenced in docker-compose.yml)
MURAW_LASTFM_DB_REPLICATION_PASSWORD=12345
