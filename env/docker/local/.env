# Docker Compose environment variables
# These variables are used for ${VAR} substitution in docker-compose.yml

# Database ports
MURAW_LASTFM_DB_PORT=9999
MU_DATA_DB_PORT=9989

# LastFM REST API (read operations) - internal ports
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_ACTUATOR_INTERNAL_PORT=8090

# LastFM ETL REST API (write operations) - internal ports
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_ACTUATOR_INTERNAL_PORT=8090

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8090

# Other services internal ports
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_ACTUATOR_INTERNAL_PORT=8090
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_ACTUATOR_INTERNAL_PORT=8090

# LastFM REST API (read operations) - external ports
MURAW_LASTFM_REST_API_EXTERNAL_PORT=9084
MURAW_LASTFM_REST_API_ACTUATOR_EXTERNAL_PORT=9094

# LastFM ETL REST API (write operations) - external ports
MURAW_LASTFM_ETL_REST_API_EXTERNAL_PORT=9085
MURAW_LASTFM_ETL_REST_API_ACTUATOR_EXTERNAL_PORT=9095

# LastFM ETL modules external actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=9096
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=9097
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=9098

# Other services external ports
MU_DATA_APP_EXTERNAL_PORT=9082
MU_DATA_ACTUATOR_EXTERNAL_PORT=9092
MU_QUIZ_APP_EXTERNAL_PORT=9083
MU_QUIZ_ACTUATOR_EXTERNAL_PORT=9093

# UI ports
MU_UI_EXTERNAL_PORT=4000

# Admin tools
DB_ADMINER_PORT=9980

# Monitoring tools
PROMETHEUS_PORT=9090
GRAFANA_PORT=9000
PROMETHEUS_DATASOURCE_UID=prometheus_local

# Backend hosts for UI build args
MURAW_LASTFM_READ_API_HOST=localhost
MURAW_LASTFM_WRITE_API_HOST=localhost
MU_DATA_APP_HOST=localhost
MU_QUIZ_APP_HOST=localhost
