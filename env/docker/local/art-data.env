# Local environment config for Art Data module
# Everything runs in Docker, containers connect to each other via service names

# Database
ART_DATA_DB_HOST=postgres-music-data
ART_DATA_DB_PORT=5432

# Application
ART_DATA_APP_INTERNAL_PORT=8080
ART_DATA_APP_CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:9081

SPRING_PROFILES_ACTIVE=local
