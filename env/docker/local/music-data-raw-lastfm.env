# database - Master (write operations)
MURAW_LASTFM_DB_MASTER_HOST=postgres-lastfm-master
MURAW_LASTFM_DB_MASTER_PORT=5432

# database - Replica (read operations)
MURAW_LASTFM_DB_REPLICA_HOST=postgres-lastfm-replica
MURAW_LASTFM_DB_REPLICA_PORT=5432

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:4000

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:4000

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080

# Spring profiles
SPRING_PROFILES_ACTIVE=local

# dependencies
MU_DATA_APP_HOST=music-data
MU_DATA_APP_PORT=8080