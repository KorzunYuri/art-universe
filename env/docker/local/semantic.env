# Semantic analysis pipeline configuration (local environment)
# Database host/port/name come from common.env
# In local (Docker), Java services use internal port 8080

# Ticket Intake Service (Go)
TICKET_SERVICE_PORT=8080

# Semantic Analyzer
SEMANTIC_ANALYZER_PORT=8080

# Semantic Analysis Response Parser
SEMANTIC_ANALYSIS_RESPONSE_PARSER_PORT=8080

# Semantic Analysis Applicator
SEMANTIC_ANALYSIS_APPLICATOR_PORT=8080
