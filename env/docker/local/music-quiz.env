# Local environment config for Music Quiz module
# Everything runs in Docker, containers connect to each other via service names

# Database
MU_DATA_DB_HOST=postgres-music-data
MU_DATA_DB_PORT=5432

# Application
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_APP_CORS_ALLOWED_ORIGINS=http://localhost:4000

SPRING_PROFILES_ACTIVE=local
