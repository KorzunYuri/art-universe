# Common variables for local environment
SPRING_PROFILES_ACTIVE=local

# Database
AU_DB_MASTER_HOST=postgres-master
AU_DB_MASTER_PORT=5432
AU_DB_REPLICA_HOST=postgres-replica
AU_DB_REPLICA_PORT=5432
