# Local environment config for Spotify modules
# Everything runs in Docker, containers connect to each other via service names

# Database - Master (write operations)
MURAW_SPOTIFY_DB_MASTER_HOST=postgres-lastfm-master
MURAW_SPOTIFY_DB_MASTER_PORT=5432

# Database - Replica (read operations)
MURAW_SPOTIFY_DB_REPLICA_HOST=postgres-lastfm-replica
MURAW_SPOTIFY_DB_REPLICA_PORT=5432

# Spotify REST API
MURAW_SPOTIFY_REST_API_INTERNAL_PORT=8080
MURAW_SPOTIFY_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:4000

SPRING_PROFILES_ACTIVE=local
