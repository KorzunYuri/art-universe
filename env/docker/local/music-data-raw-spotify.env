# Local environment config for Spotify modules
# Everything runs in Docker, containers connect to each other via service names

# Spotify REST API
MURAW_SPOTIFY_REST_API_INTERNAL_PORT=8080
MURAW_SPOTIFY_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:4000

# Dependencies - connect to other services via container names
MU_DATA_APP_HOST=music-data
MU_DATA_APP_PORT=8080
