# Common variables for production environment
# Database runs on Windows host, services run in Docker
# Services connect to database via host.docker.internal
SPRING_PROFILES_ACTIVE=prod

# Database
AU_DB_MASTER_HOST=host.docker.internal
AU_DB_MASTER_PORT=5432
AU_DB_REPLICA_HOST=host.docker.internal
AU_DB_REPLICA_PORT=5433
AU_DB_NAME=art_universe

# Distributed Tracing
ZIPKIN_BASE_URL=http://zipkin:9411
