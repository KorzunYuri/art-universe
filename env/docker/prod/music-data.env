# Production environment config for Music Data module
# Database runs on Windows host, service runs in Docker
# Service connects to database via host.docker.internal

# Database
MU_DATA_DB_HOST=host.docker.internal
MU_DATA_DB_PORT=5432

# Application
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8085

SPRING_PROFILES_ACTIVE=prod
