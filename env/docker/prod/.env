# Docker Compose environment variables
# These variables are used for ${VAR} substitution in docker-compose.yml

# Art Data service
ART_DATA_APP_HOST=localhost
ART_DATA_APP_INTERNAL_PORT=8080
ART_DATA_APP_EXTERNAL_PORT=8081

# Auth service
AU_AUTH_APP_INTERNAL_PORT=8080
AU_AUTH_APP_EXTERNAL_PORT=8071

# Config service
AU_CONFIG_APP_INTERNAL_PORT=8080
AU_CONFIG_APP_EXTERNAL_PORT=8070

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_HOST=localhost
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_EXTERNAL_PORT=8084

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_HOST=localhost
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_EXTERNAL_PORT=8085

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=8086

MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=8087

MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=8088

# Spotify REST API
MURAW_SPOTIFY_REST_API_HOST=localhost
MURAW_SPOTIFY_REST_API_INTERNAL_PORT=8080
MURAW_SPOTIFY_REST_API_EXTERNAL_PORT=8094

# Spotify ETL modules actuator ports
MURAW_SPOTIFY_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=8091
MURAW_SPOTIFY_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=8092
MURAW_SPOTIFY_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=8093
MURAW_SPOTIFY_STAGING_APPLICATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_STAGING_APPLICATOR_ACTUATOR_EXTERNAL_PORT=8095

# master-data service
MU_DATA_APP_HOST=localhost
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_APP_EXTERNAL_PORT=8082

# music-quiz service
MU_QUIZ_APP_HOST=localhost
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_APP_EXTERNAL_PORT=8083

# UI ports
MU_UI_EXTERNAL_PORT=3000

# Semantic pipeline
SEMANTIC_ANALYZER_ACTUATOR_INTERNAL_PORT=8080
SEMANTIC_ANALYZER_ACTUATOR_EXTERNAL_PORT=8096
SEMANTIC_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080
SEMANTIC_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=8097
SEMANTIC_APPLICATOR_ACTUATOR_INTERNAL_PORT=8080
SEMANTIC_APPLICATOR_ACTUATOR_EXTERNAL_PORT=8098
LASTFM_ANALYSIS_TRIGGER_ACTUATOR_INTERNAL_PORT=8080
LASTFM_ANALYSIS_TRIGGER_ACTUATOR_EXTERNAL_PORT=8099
MASTER_CATEGORY_ANALYZER_ACTUATOR_INTERNAL_PORT=8080
MASTER_CATEGORY_ANALYZER_ACTUATOR_EXTERNAL_PORT=8100
TICKET_INTAKE_SERVICE_INTERNAL_PORT=7095
TICKET_INTAKE_SERVICE_EXTERNAL_PORT=8101

# Monitoring tools
PROMETHEUS_PORT=8090
GRAFANA_PORT=8000
PROMETHEUS_DATASOURCE_UID=prometheus_prod
