# Docker Compose environment variables
# These variables are used for ${VAR} substitution in docker-compose.yml

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_HOST=localhost
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_EXTERNAL_PORT=8084
MURAW_LASTFM_REST_API_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_REST_API_ACTUATOR_EXTERNAL_PORT=8094

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_HOST=localhost
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_EXTERNAL_PORT=8085
MURAW_LASTFM_ETL_REST_API_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_ETL_REST_API_ACTUATOR_EXTERNAL_PORT=8095

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_EXTERNAL_PORT=8096

MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_EXTERNAL_PORT=8097

MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_EXTERNAL_PORT=8098

# master-data service
MU_DATA_APP_HOST=localhost
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_APP_EXTERNAL_PORT=8082
MU_DATA_ACTUATOR_INTERNAL_PORT=8090
MU_DATA_ACTUATOR_EXTERNAL_PORT=8092

# music-quiz service
MU_QUIZ_APP_HOST=localhost
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_APP_EXTERNAL_PORT=8083
MU_QUIZ_ACTUATOR_INTERNAL_PORT=8090
MU_QUIZ_ACTUATOR_EXTERNAL_PORT=8093

# UI ports
MU_UI_EXTERNAL_PORT=3000

# Admin tools
DB_ADMINER_PORT=8880

# Monitoring tools
PROMETHEUS_PORT=8090
GRAFANA_PORT=8000
PROMETHEUS_DATASOURCE_UID=prometheus_prod
