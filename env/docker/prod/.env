# Docker Compose environment variables
# These variables are used for ${VAR} substitution in docker-compose.yml

# Application internal ports (inside containers)
MURAW_LASTFM_APP_INTERNAL_PORT=8080
MURAW_LASTFM_ACTUATOR_INTERNAL_PORT=8090
MU_DATA_APP_INTERNAL_PORT=8080
MU_DATA_ACTUATOR_INTERNAL_PORT=8090
MU_QUIZ_APP_INTERNAL_PORT=8080
MU_QUIZ_ACTUATOR_INTERNAL_PORT=8090

# Application external ports (host machine)
MURAW_LASTFM_APP_EXTERNAL_PORT=8081
MURAW_LASTFM_ACTUATOR_EXTERNAL_PORT=8091
MU_DATA_APP_EXTERNAL_PORT=8082
MU_DATA_ACTUATOR_EXTERNAL_PORT=8092
MU_QUIZ_APP_EXTERNAL_PORT=8083
MU_QUIZ_ACTUATOR_EXTERNAL_PORT=8093

# UI ports
MU_UI_EXTERNAL_PORT=3000

# Admin tools
DB_ADMINER_PORT=8880

# Monitoring tools
PROMETHEUS_PORT=8090
GRAFANA_PORT=8000
PROMETHEUS_DATASOURCE_UID=prometheus_prod

# Backend hosts for UI build args
MURAW_LASTFM_APP_HOST=localhost
MU_DATA_APP_HOST=localhost
MU_QUIZ_APP_HOST=localhost
