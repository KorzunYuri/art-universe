# database
MURAW_LASTFM_DB_HOST=host.docker.internal
MURAW_LASTFM_DB_PORT=5432

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8090
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8090

# Spring profiles
SPRING_PROFILES_ACTIVE=prod

# dependencies
MU_DATA_APP_HOST=music-data
MU_DATA_APP_PORT=8080
