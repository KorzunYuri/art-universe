# Production environment config for LastFM modules
# Database runs on Windows host, services run in Docker
# Services connect to database via host.docker.internal

# LastFM REST API (read operations)
MURAW_LASTFM_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# LastFM ETL REST API (write operations)
MURAW_LASTFM_ETL_REST_API_INTERNAL_PORT=8080
MURAW_LASTFM_ETL_REST_API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# LastFM ETL modules actuator ports
MURAW_LASTFM_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_LASTFM_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080

# Dependencies - connect to other services via service names
MU_DATA_APP_HOST=music-data
MU_DATA_APP_PORT=8080
