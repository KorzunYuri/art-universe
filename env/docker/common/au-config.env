AU_CONFIG_DB_SCHEMA=au_config
AU_CONFIG_DB_USERNAME=au_config_dm
AU_CONFIG_DB_MIGRATIONS_PATH=db/migration/au_config/liquibase/db.changelog.xml

# override to launch on the same host with other apps
AU_CONFIG_APP_INTERNAL_PORT=8080

# URL for config-client services to reach this service
AU_CONFIG_SERVICE_URL=http://au-config-service:8080