# actuator ports, should be overwritten for dev
MURAW_SPOTIFY_CALLS_GENERATOR_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_CALLS_PERFORMER_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_RESPONSE_PARSER_ACTUATOR_INTERNAL_PORT=8080
MURAW_SPOTIFY_STAGING_APPLICATOR_ACTUATOR_INTERNAL_PORT=8080

# Search pipeline
SPOTIFY_SEARCH_ENABLED=true

# Spotify API rate limiting
SPOTIFY_RATE_LIMITER_INITIAL_DELAY_MS=2000
SPOTIFY_RATE_LIMITER_MIN_DELAY_MS=1000
SPOTIFY_RATE_LIMITER_MAX_DELAY_MS=30000
SPOTIFY_RATE_LIMITER_BACKOFF_MULTIPLIER=2.0
SPOTIFY_RATE_LIMITER_RECOVERY_STEP_MS=100
