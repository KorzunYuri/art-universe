        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*P95.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
