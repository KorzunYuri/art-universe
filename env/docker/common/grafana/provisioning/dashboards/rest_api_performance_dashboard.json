      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (application, uri, method) (rate(http_server_requests_seconds_sum{application=~\"$service\", uri=~\"$uri\", method=~\"$http_method\"}[5m])) / sum by (application, uri, method) (rate(http_server_requests_seconds_count{application=~\"$service\", uri=~\"$uri\", method=~\"$http_method\"}[5m]))",
