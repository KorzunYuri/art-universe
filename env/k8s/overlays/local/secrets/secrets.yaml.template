# Art Universe - Kubernetes Secrets Template
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to version control!

---
# =============================================================================
# mu-data namespace - Database credentials
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  # PostgreSQL superuser password
  POSTGRES_PASSWORD: "<CHANGE_ME>"
  # LastFM data management user (write access)
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"
  # LastFM read-only user (for replica reads)
  MURAW_LASTFM_DB_READER_PASSWORD: "<CHANGE_ME>"
  # Replication user password
  MURAW_LASTFM_DB_REPLICATION_PASSWORD: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: music-data-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  # PostgreSQL superuser password
  POSTGRES_PASSWORD: "<CHANGE_ME>"
  # Music Data management user
  MU_DATA_DB_PASSWORD_DM: "<CHANGE_ME>"
  # Music Quiz management user
  MU_QUIZ_DB_PASSWORD_DM: "<CHANGE_ME>"

---
# =============================================================================
# mu-lastfm namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-api-key
  namespace: mu-lastfm
type: Opaque
stringData:
  # LastFM API key for data collection
  # Get your key from: https://www.last.fm/api/account/create
  MURAW_LASTFM_API_KEY: "<CHANGE_ME>"

---
# Duplicate lastfm-db-credentials in mu-lastfm namespace for service access
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-lastfm
type: Opaque
stringData:
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"
  MURAW_LASTFM_DB_READER_PASSWORD: "<CHANGE_ME>"

---
# =============================================================================
# mu-apps namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: music-data-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_DATA_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: music-quiz-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_QUIZ_DB_PASSWORD_DM: "<CHANGE_ME>"
