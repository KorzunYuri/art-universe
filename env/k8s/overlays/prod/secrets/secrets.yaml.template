# Art Universe - Production Kubernetes Secrets Template
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to version control!
#
# Note: Unlike the local overlay, prod does not need POSTGRES_PASSWORD or
# MURAW_LASTFM_DB_REPLICATION_PASSWORD since databases run externally.

---
# =============================================================================
# mu-data namespace - Migration job credentials
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  # LastFM data management user (used by Liquibase migration job)
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"

---
# =============================================================================
# mu-lastfm namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-api-key
  namespace: mu-lastfm
type: Opaque
stringData:
  # LastFM API key for data collection
  # Get your key from: https://www.last.fm/api/account/create
  MURAW_LASTFM_API_KEY: "<CHANGE_ME>"

---
# LastFM database credentials for services
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-lastfm
type: Opaque
stringData:
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"
  MURAW_LASTFM_DB_READER_PASSWORD: "<CHANGE_ME>"

---
# =============================================================================
# mu-apps namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: music-data-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_DATA_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: music-quiz-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_QUIZ_DB_PASSWORD_DM: "<CHANGE_ME>"
