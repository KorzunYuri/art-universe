# Art Universe - Production Kubernetes Secrets Template
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to version control!
#
# Note: Unlike the local overlay, prod does not need POSTGRES_PASSWORD or
# MURAW_LASTFM_DB_REPLICATION_PASSWORD since databases run externally.

---
# =============================================================================
# mu-data namespace - Migration job credentials
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  # LastFM data management user (used by Liquibase migration job)
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: spotify-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  # Spotify data management user (used by Liquibase migration job)
  MURAW_SPOTIFY_DB_WRITER_PASSWORD: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: au-config-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  AU_CONFIG_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: au-auth-db-credentials
  namespace: mu-data
type: Opaque
stringData:
  AU_AUTH_DB_PASSWORD_DM: "<CHANGE_ME>"

---
# =============================================================================
# mu-lastfm namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-api-key
  namespace: mu-lastfm
type: Opaque
stringData:
  # LastFM API key for data collection
  # Get your key from: https://www.last.fm/api/account/create
  MURAW_LASTFM_API_KEY: "<CHANGE_ME>"

---
# LastFM database credentials for services
apiVersion: v1
kind: Secret
metadata:
  name: lastfm-db-credentials
  namespace: mu-lastfm
type: Opaque
stringData:
  MURAW_LASTFM_DB_WRITER_PASSWORD: "<CHANGE_ME>"
  MURAW_LASTFM_DB_READER_PASSWORD: "<CHANGE_ME>"

---
# Auth credentials for LastFM services (JWT validation)
apiVersion: v1
kind: Secret
metadata:
  name: au-auth-credentials
  namespace: mu-lastfm
type: Opaque
stringData:
  AUTH_JWT_SECRET: "<CHANGE_ME>"

---
# =============================================================================
# mu-spotify namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: spotify-api-credentials
  namespace: mu-spotify
type: Opaque
stringData:
  # Spotify API credentials
  # Get from: https://developer.spotify.com/dashboard
  SPOTIFY_CLIENT_ID: "<CHANGE_ME>"
  SPOTIFY_CLIENT_SECRET: "<CHANGE_ME>"

---
# Spotify database credentials for services
apiVersion: v1
kind: Secret
metadata:
  name: spotify-db-credentials
  namespace: mu-spotify
type: Opaque
stringData:
  MURAW_SPOTIFY_DB_READER_PASSWORD: "<CHANGE_ME>"
  MURAW_SPOTIFY_DB_WRITER_PASSWORD: "<CHANGE_ME>"
  MURAW_SPOTIFY_CALLS_GENERATOR_DB_PASSWORD: "<CHANGE_ME>"
  MURAW_SPOTIFY_CALLS_PERFORMER_DB_PASSWORD: "<CHANGE_ME>"
  MURAW_SPOTIFY_RESPONSE_PARSER_DB_PASSWORD: "<CHANGE_ME>"
  MURAW_SPOTIFY_STAGING_APPLICATOR_DB_PASSWORD: "<CHANGE_ME>"

---
# Auth credentials for Spotify services (JWT validation)
apiVersion: v1
kind: Secret
metadata:
  name: au-auth-credentials
  namespace: mu-spotify
type: Opaque
stringData:
  AUTH_JWT_SECRET: "<CHANGE_ME>"

---
# =============================================================================
# au-core namespace - Core service secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: au-config-db-credentials
  namespace: au-core
type: Opaque
stringData:
  AU_CONFIG_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: au-auth-credentials
  namespace: au-core
type: Opaque
stringData:
  AU_AUTH_DB_PASSWORD_DM: "<CHANGE_ME>"
  AUTH_JWT_SECRET: "<CHANGE_ME>"

---
# =============================================================================
# mu-apps namespace - Application secrets
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: music-data-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_DATA_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: music-quiz-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  MU_QUIZ_DB_PASSWORD_DM: "<CHANGE_ME>"

---
apiVersion: v1
kind: Secret
metadata:
  name: art-data-db-credentials
  namespace: mu-apps
type: Opaque
stringData:
  ART_DATA_DB_PASSWORD_DM: "<CHANGE_ME>"

---
# Auth credentials shared by services that validate JWT tokens
apiVersion: v1
kind: Secret
metadata:
  name: au-auth-credentials
  namespace: mu-apps
type: Opaque
stringData:
  AUTH_JWT_SECRET: "<CHANGE_ME>"
