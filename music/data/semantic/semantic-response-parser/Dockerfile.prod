# Build stage
FROM gradle:8-jdk21 as build
WORKDIR /app

COPY build.gradle settings.gradle gradle.properties ./
COPY buildSrc/ buildSrc/
COPY common/ common/

COPY music/data/semantic/semantic-models/build.gradle music/data/semantic/semantic-models/
COPY music/data/semantic/semantic-models/src/ music/data/semantic/semantic-models/src/

COPY music/data/semantic/semantic-response-parser/build.gradle music/data/semantic/semantic-response-parser/
COPY music/data/semantic/semantic-response-parser/src/ music/data/semantic/semantic-response-parser/src/

ENV GRADLE_OPTS="-Xmx1536m -XX:MaxMetaspaceSize=384m -XX:+HeapDumpOnOutOfMemoryError"

RUN gradle :music:data:semantic:semantic-response-parser:bootJar :music:data:semantic:semantic-response-parser:extractLayers --no-daemon

# Runtime stage
FROM eclipse-temurin:21-jre
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/music/data/semantic/semantic-response-parser/build/docker-layers/dependencies/ ./dependencies/
COPY --from=build /app/music/data/semantic/semantic-response-parser/build/docker-layers/spring-boot-loader/ ./spring-boot-loader/
COPY --from=build /app/music/data/semantic/semantic-response-parser/build/docker-layers/snapshot-dependencies/ ./snapshot-dependencies/
COPY --from=build /app/music/data/semantic/semantic-response-parser/build/docker-layers/application/ ./application/

EXPOSE 7097

ENTRYPOINT ["java", \
            "-XX:MaxRAMPercentage=75.0", \
            "-XX:InitialRAMPercentage=50.0", \
            "-Djava.security.egd=file:/dev/./urandom", \
            "-Dspring.output.ansi.enabled=ALWAYS", \
            "-cp", "application/*:application/lib/*:dependencies/lib/*", \
            "yurykorzun.art.universe.music.data.semantic.parser.SemanticAnalysisResponseParserApplication"]
