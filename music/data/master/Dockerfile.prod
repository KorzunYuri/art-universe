# Build stage
FROM gradle:8-jdk21 as build
WORKDIR /app

# Copy build files
COPY build.gradle settings.gradle ./

# Copy buildSrc for custom plugins
COPY buildSrc/ buildSrc/

# Copy commons module
COPY commons/build.gradle commons/
COPY commons/src/ commons/src/

# Copy current module
COPY music/data/master/build.gradle music/data/master/
COPY music/data/master/src/ music/data/master/src/

# Build the application and extract layers
RUN gradle :music:data:master:bootJar :music:data:master:extractLayers --no-daemon

# Runtime stage
FROM eclipse-temurin:21-jre
WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy layers in order of frequency of change (for optimal Docker layer caching)
COPY --from=build /app/music/data/master/build/docker-layers/dependencies/ ./dependencies/
COPY --from=build /app/music/data/master/build/docker-layers/spring-boot-loader/ ./spring-boot-loader/
COPY --from=build /app/music/data/master/build/docker-layers/snapshot-dependencies/ ./snapshot-dependencies/
COPY --from=build /app/music/data/master/build/docker-layers/application/ ./application/

EXPOSE 8080

# Run the application with proper classpath (thin JAR needs dependencies)
ENTRYPOINT ["java", \
            "-XX:MaxRAMPercentage=75.0", \
            "-XX:InitialRAMPercentage=50.0", \
            "-Djava.security.egd=file:/dev/./urandom", \
            "-Dspring.output.ansi.enabled=ALWAYS", \
            "-cp", "application/*:application/lib/*:dependencies/lib/*", \
            "yurykorzun.art.universe.music.data.master.MusicUniverseDataApplication"]
