# Build stage
FROM gradle:8-jdk21 as build
WORKDIR /app

COPY build.gradle settings.gradle gradle.properties ./
COPY buildSrc/ buildSrc/
COPY common/ common/

COPY music/data/raw/lastfm/lastfm-models/build.gradle music/data/raw/lastfm/lastfm-models/
COPY music/data/raw/lastfm/lastfm-models/src/ music/data/raw/lastfm/lastfm-models/src/

COPY music/data/raw/lastfm/lastfm-repositories/build.gradle music/data/raw/lastfm/lastfm-repositories/
COPY music/data/raw/lastfm/lastfm-repositories/src/ music/data/raw/lastfm/lastfm-repositories/src/

COPY music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/build.gradle music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/
COPY music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/src/ music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/src/

ENV GRADLE_OPTS="-Xmx1536m -XX:MaxMetaspaceSize=384m -XX:+HeapDumpOnOutOfMemoryError"

RUN gradle :music:data:raw:lastfm:etl:lastfm-semantic-analysis-trigger:bootJar :music:data:raw:lastfm:etl:lastfm-semantic-analysis-trigger:extractLayers --no-daemon

# Runtime stage
FROM eclipse-temurin:21-jre
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/build/docker-layers/dependencies/ ./dependencies/
COPY --from=build /app/music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/build/docker-layers/spring-boot-loader/ ./spring-boot-loader/
COPY --from=build /app/music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/build/docker-layers/snapshot-dependencies/ ./snapshot-dependencies/
COPY --from=build /app/music/data/raw/lastfm/etl/lastfm-semantic-analysis-trigger/build/docker-layers/application/ ./application/

EXPOSE 8080

ENTRYPOINT ["java", \
            "-XX:MaxRAMPercentage=75.0", \
            "-XX:InitialRAMPercentage=50.0", \
            "-Djava.security.egd=file:/dev/./urandom", \
            "-Dspring.output.ansi.enabled=ALWAYS", \
            "-cp", "application/*:application/lib/*:dependencies/lib/*", \
            "yurykorzun.art.universe.music.data.raw.lastfm.etl.trigger.LastfmSemanticAnalysisTriggerApplication"]
