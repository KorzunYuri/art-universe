apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: $PROMETHEUS_DATASOURCE_UID
    url: http://prometheus:9090
    access: proxy
    isDefault: true
    basicAuth: false
    withCredentials: false
    jsonData:
      httpMethod: GET
      timeInterval: 5s
    version: 1
    editable: true
